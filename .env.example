# ==============================================================================
# RONALDIANS IN BENGAL (RFCU) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local testing or configure in Netlify Site Environment Variables
# ==============================================================================

PORT=3000
NODE_ENV=production

# WhatsApp Community Numbers (Country code + 10-digit number without '+' or '-')
COMMUNITY_WHATSAPP_NUMBER=916296277118
ORDER_WHATSAPP_NUMBER=919163398371

# Supabase Project URL & Publishable Anon Key
# Configure these in your .env or in Netlify Site Settings > Environment Variables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
